#include <Arduino.h>
#include <math.h>

#if defined(ARDUINO_ARCH_ESP32)
constexpr uint8_t InputPin = 36; // VP on the ESP32 DevKitC
constexpr int AdcMax = 4095;
constexpr float MinimumPeak = 12.0f;
#else
constexpr uint8_t InputPin = A0;
constexpr int AdcMax = 1023;
constexpr float MinimumPeak = 4.0f;
#endif

constexpr uint32_t SampleUs = 8000; // The original filter requires 125 Hz.
// The Uno may reset when opening Serial Plotter. These select its startup modes.
constexpr bool StartInPlotMode = true;
constexpr bool StartWithDemoEcg = false;
constexpr uint32_t ReportMs = 600;
constexpr uint32_t CalibrationMs = 30000;
constexpr uint8_t RingSize = 64;
constexpr uint8_t Before = 15;
constexpr uint8_t After = 25;
constexpr uint8_t BeatSize = Before + After + 1;
constexpr uint8_t TemplateBeats = 5;
constexpr uint8_t PeakSearch = 6;
constexpr uint8_t Refractory = 35;
constexpr uint16_t MaxRrMs = 4000;

float ECGFilter(float input);

template <typename T>
T median(T *values, uint8_t count) {
  for (uint8_t i = 1; i < count; ++i) {
    const T value = values[i];
    uint8_t j = i;
    while (j > 0 && values[j - 1] > value) {
      values[j] = values[j - 1];
      --j;
    }
    values[j] = value;
  }
  return values[count / 2];
}

int16_t ecg[RingSize];
int16_t recentBeats[TemplateBeats][BeatSize];
uint8_t beatNext = 0;
uint8_t beatCount = 0;
int16_t baselineBeat[BeatSize];
int8_t baselineEnd = -1;
constexpr uint8_t MaxBaselineIntervals = 64;
uint16_t baselineIntervals[MaxBaselineIntervals];
uint8_t calibrationCount = 0;
uint16_t baselineRr = 0;
uint16_t recentIntervals[5];
uint8_t rrCount = 0;
uint8_t rrNext = 0;

uint32_t nextSampleUs;
uint32_t nextReportMs;
uint32_t startedMs;
uint32_t calibrationStart;
uint32_t sampleIndex = 0;
uint32_t peakSearchStart;
uint32_t strongestIndex;
uint32_t anchorIndex;
uint32_t lastGoodIndex;
uint32_t lastClipIndex;
uint8_t continuousSamples = 0;
float strongestPeak;
float peakLevel = MinimumPeak * 3;
bool searching = false;
bool pending = false;
bool haveAnchor = false;
bool haveGoodBeat = false;
bool sawClip = false;
bool calibrating = false;
bool showWindows = false;
bool simulateEcg = false;
bool plotMode = StartInPlotMode;

// Long waveform rows are sent in chunks so they don't block sampling.
char tx[260];
size_t txSize = 0;
size_t txSent = 0;
uint32_t droppedWindows = 0;

float sampleAt(uint32_t index) { return ecg[index % RingSize]; }

void drainOutput() {
  if (txSent == txSize) return;
  const int room = Serial.availableForWrite();
  if (room <= 0) return;
  const size_t remaining = txSize - txSent;
  const size_t bytes = remaining < (size_t)room ? remaining : (size_t)room;
  txSent += Serial.write((const uint8_t *)tx + txSent, bytes);
}

void queueWindow(uint32_t anchor, const int16_t *beat) {
  if (plotMode || !showWindows) return;
  if (txSent != txSize) {
    ++droppedWindows;
    return;
  }
  // Worst case: 12 prefix bytes + 41 values of at most 6 bytes + newline.
  size_t used = snprintf(tx, sizeof(tx), "%c,%lu", simulateEcg ? 'V' : 'W',
                         (unsigned long)anchor);
  for (uint8_t i = 0; i < BeatSize; ++i) {
    used += snprintf(tx + used, sizeof(tx) - used, ",%d", (int)beat[i]);
  }
  tx[used++] = '\n';
  txSent = 0;
  txSize = used;
}

void clearLive() {
  beatNext = beatCount = rrNext = rrCount = 0;
  haveGoodBeat = false;
}

void makeTemplate(int16_t *result) {
  for (uint8_t i = 0; i < BeatSize; ++i) {
    int16_t values[TemplateBeats];
    for (uint8_t beat = 0; beat < TemplateBeats; ++beat) {
      values[beat] = recentBeats[beat][i];
    }
    result[i] = median(values, TemplateBeats);
  }
}

// Approximate the boundary using three quiet slopes after the QRS peak.
int8_t estimateQrsEnd(const int16_t *beat) {
  int slopeLimit = 22; // The normalized peak scale is 1000.
  for (uint8_t i = 1; i < 5; ++i) {
    const int noise = 2 * abs(beat[i] - beat[i - 1]);
    if (noise > slopeLimit) slopeLimit = noise;
  }
  for (uint8_t i = Before + 5; i <= Before + 15; ++i) {
    if (abs(beat[i] - beat[i - 1]) <= slopeLimit &&
        abs(beat[i + 1] - beat[i]) <= slopeLimit &&
        abs(beat[i + 2] - beat[i + 1]) <= slopeLimit) {
      return i;
    }
  }
  return -1;
}

void finishBeat() {
  pending = false;
  const uint32_t first = anchorIndex - Before;
  const uint32_t last = anchorIndex + After;
  if (sawClip && (uint32_t)(last - lastClipIndex) < BeatSize) {
    clearLive();
    return;
  }

  float center = 0;
  float low = sampleAt(first);
  float high = low;
  for (uint8_t i = 0; i < 5; ++i) {
    const float value = sampleAt(first + i);
    center += value;
    if (value < low) low = value;
    if (value > high) high = value;
  }
  center /= 5;
  const float scale = fabsf(sampleAt(anchorIndex) - center);
  if (scale < MinimumPeak || high - low > 0.22f * scale) {
    clearLive();
    return;
  }

  if (haveGoodBeat) {
    const uint32_t rrMs = (anchorIndex - lastGoodIndex) * (SampleUs / 1000);
    if (rrMs >= 280 && rrMs <= MaxRrMs) {
      recentIntervals[rrNext] = (uint16_t)rrMs;
      rrNext = (rrNext + 1) % 5;
      if (rrCount < 5) ++rrCount;
      if (calibrating && calibrationCount < MaxBaselineIntervals) {
        baselineIntervals[calibrationCount++] = (uint16_t)rrMs;
      }
    } else {
      clearLive();
    }
  }
  lastGoodIndex = anchorIndex;
  haveGoodBeat = true;

  int16_t *beat = recentBeats[beatNext];
  for (uint8_t i = 0; i < BeatSize; ++i) {
    const float normalized = 1000.0f * (sampleAt(first + i) - center) / scale;
    beat[i] = (int16_t)constrain(normalized, -4000.0f, 4000.0f);
  }
  beatNext = (beatNext + 1) % TemplateBeats;
  if (beatCount < TemplateBeats) ++beatCount;
  queueWindow(anchorIndex, beat);
}

void queuePlotSample(int16_t filtered) {
  if (txSent != txSize) return;
  // Arduino Serial Plotter expects one labeled numeric sample per line.
  txSize = snprintf(tx, sizeof(tx), "%s:%d\n",
                    simulateEcg ? "Demo_ECG" : "ECG", (int)filtered);
  txSent = 0;
}

void acquire(int raw) {
  ++sampleIndex;
  if (continuousSamples < RingSize) ++continuousSamples;
  const float signal = ECGFilter((float)raw);
  const int16_t filtered = (int16_t)lroundf(signal);
  ecg[sampleIndex % RingSize] = filtered;
  const bool filterSettled = millis() - startedMs >= 2000;
  if (plotMode && filterSettled) queuePlotSample(filtered);
  if (raw <= 2 || raw >= AdcMax - 2) {
    lastClipIndex = sampleIndex;
    sawClip = true;
  }
  if (pending && sampleIndex - anchorIndex >= After) finishBeat();

  if (continuousSamples < Before + 1 || !filterSettled) return;
  const float magnitude = fabsf(signal);
  if (searching) {
    if (magnitude > strongestPeak) {
      strongestPeak = magnitude;
      strongestIndex = sampleIndex;
    }
    if (sampleIndex - peakSearchStart >= PeakSearch) {
      searching = false;
      anchorIndex = strongestIndex;
      haveAnchor = pending = true;
      peakLevel += 0.2f * (strongestPeak - peakLevel);
    }
    return;
  }

  if (haveAnchor && sampleIndex - anchorIndex < Refractory) return;
  const float threshold = fmaxf(MinimumPeak, 0.36f * peakLevel);
  if (magnitude >= threshold) {
    peakSearchStart = strongestIndex = sampleIndex;
    strongestPeak = magnitude;
    searching = true;
  } else if (!haveAnchor || sampleIndex - anchorIndex > 250) {
    peakLevel = fmaxf(MinimumPeak * 3, 0.995f * peakLevel);
  }
}

void startCalibration(uint32_t now) {
  calibrating = true;
  calibrationStart = now;
  calibrationCount = 0;
  baselineRr = 0;
  baselineEnd = -1;
  clearLive();
}

void selectInput(bool simulation, uint32_t now) {
  if (simulateEcg == simulation) return;
  simulateEcg = simulation;
  // Keep baseline and detector state separate between test and live input.
  baselineRr = 0;
  baselineEnd = -1;
  calibrationCount = 0;
  calibrating = false;
  continuousSamples = 0;
  searching = pending = haveAnchor = sawClip = false;
  peakLevel = simulation ? 150.0f : MinimumPeak * 3;
  clearLive();
  startedMs = now; // Let the existing ECG filter settle.
}

int simulatedSample(uint32_t index) {
  // 125 samples per period at 125 Hz gives one beat per second (60 BPM).
  const int phase = index % (1000000UL / SampleUs);
  int level = AdcMax / 2;
  // Small P and T waves flank the signed QRS complex in this demo.
  if (phase >= 8 && phase <= 20) level += 2 * (6 - abs(phase - 14));
  if (phase >= 27 && phase <= 34) {
    const int16_t qrs[] = {-15, -65, 65, 300, 65, -195, -115, -40};
    level += qrs[phase - 27];
  }
  if (phase >= 46 && phase <= 70) level += 2 * (12 - abs(phase - 58));
  return level;
}

void report(uint32_t now) {
  const char *status = "collecting";
  int liveRr = -1;
  int shapeDifference = -1;
  int qrsEndMs = -1;
  if (!haveGoodBeat || sampleIndex - lastGoodIndex > MaxRrMs / (SampleUs / 1000)) {
    clearLive();
    status = "no_usable_beat";
  } else if (rrCount == 5) {
    uint16_t intervals[5];
    for (uint8_t i = 0; i < 5; ++i) intervals[i] = recentIntervals[i];
    liveRr = median(intervals, 5);
    status = baselineRr ? "comparing" : "needs_baseline";
  }

  if (calibrating && now - calibrationStart >= CalibrationMs &&
      calibrationCount >= 8 && beatCount == TemplateBeats && liveRr > 0) {
    baselineRr = median(baselineIntervals, calibrationCount);
    makeTemplate(baselineBeat);
    baselineEnd = estimateQrsEnd(baselineBeat);
    calibrating = false;
    status = "baseline_ready";
  }
  if (calibrating) status = "calibrating";

  if (beatCount == TemplateBeats) {
    int16_t liveBeat[BeatSize];
    makeTemplate(liveBeat);
    const int8_t liveEnd = estimateQrsEnd(liveBeat);
    if (liveEnd >= 0) {
      qrsEndMs = (liveEnd - Before) * (SampleUs / 1000);
      if (baselineEnd >= 0) {
        // Compare the first 56 ms from the estimated QRS end.
        long difference = 0;
        for (uint8_t i = 0; i < 8; ++i) {
          difference += abs(liveBeat[liveEnd + i] - baselineBeat[baselineEnd + i]);
        }
        shapeDifference = difference / 8;
      }
    }
  }

  const int baselineBpm10 = baselineRr ? 600000L / baselineRr : -1;
  const int liveBpm10 = liveRr > 0 ? 600000L / liveRr : -1;
  char deltaBpm10[8] = "NA";
  if (baselineRr && liveRr > 0) snprintf(deltaBpm10, sizeof(deltaBpm10), "%d", liveBpm10 - baselineBpm10);
  txSize = snprintf(tx, sizeof(tx), "%c,%lu,%s,%u,%d,%d,%d,%s,%d,%d,%lu\n",
                    simulateEcg ? 'T' : 'S', (unsigned long)now, status,
                    (unsigned int)baselineRr, liveRr,
                    baselineBpm10, liveBpm10, deltaBpm10, qrsEndMs, shapeDifference,
                    (unsigned long)droppedWindows);
  txSent = 0;
}

void setup() {
  Serial.begin(115200);
#if defined(ARDUINO_ARCH_ESP32)
  analogReadResolution(12);
  analogSetPinAttenuation(InputPin, ADC_11db);
#endif
  startedMs = millis();
  selectInput(StartWithDemoEcg, startedMs);
  nextReportMs = startedMs + ReportMs;
  nextSampleUs = micros();
}

void loop() {
  const uint32_t nowUs = micros();
  if ((int32_t)(nowUs - nextSampleUs) >= 0) {
    const uint32_t skipped = (nowUs - nextSampleUs) / SampleUs;
    if (skipped) {
      sampleIndex += skipped;
      continuousSamples = 0;
      searching = pending = haveAnchor = false;
      clearLive();
    }
    nextSampleUs += (skipped + 1) * SampleUs;
    acquire(simulateEcg ? simulatedSample(sampleIndex) : analogRead(InputPin));
  }

  const uint32_t nowMs = millis();
  if (Serial.available()) {
    const int command = Serial.read();
    if (command == 'b' || command == 'B') startCalibration(nowMs);
    if (command == 'w' || command == 'W') showWindows = !showWindows;
    if (command == 't' || command == 'T') selectInput(true, nowMs);
    if (command == 'l' || command == 'L') selectInput(false, nowMs);
    if (command == 'p' || command == 'P') plotMode = true;
    if (command == 'c' || command == 'C') {
      plotMode = false;
      nextReportMs = nowMs;
    }
  }
  drainOutput();
  if (!plotMode && (int32_t)(nowMs - nextReportMs) >= 0 && txSize == txSent) {
    nextReportMs += ((nowMs - nextReportMs) / ReportMs + 1) * ReportMs;
    report(nowMs);
  }
}

// Band-Pass Butterworth IIR digital filter, generated using filter_gen.py.
// Sampling rate: 125.0 Hz, frequency: [0.5, 44.5] Hz.
// Filter is order 4, implemented as second-order sections (biquads).
// Reference:
// https://docs.scipy.org/doc/scipy/reference/generated/scipy.signal.butter.html
// https://courses.ideate.cmu.edu/16-223/f2020/Arduino/FilterDemos/filter_gen.py
float ECGFilter(float input) {
  float output = input;
  {
    static float z1, z2;  // filter section state
    float x = output - 0.70682283 * z1 - 0.15621030 * z2;
    output = 0.28064917 * x + 0.56129834 * z1 + 0.28064917 * z2;
    z2 = z1;
    z1 = x;
  }
  {
    static float z1, z2;  // filter section state
    float x = output - 0.95028224 * z1 - 0.54073140 * z2;
    output = 1.00000000 * x + 2.00000000 * z1 + 1.00000000 * z2;
    z2 = z1;
    z1 = x;
  }
  {
    static float z1, z2;  // filter section state
    float x = output - -1.95360385 * z1 - 0.95423412 * z2;
    output = 1.00000000 * x + -2.00000000 * z1 + 1.00000000 * z2;
    z2 = z1;
    z1 = x;
  }
  {
    static float z1, z2;  // filter section state
    float x = output - -1.98048558 * z1 - 0.98111344 * z2;
    output = 1.00000000 * x + -2.00000000 * z1 + 1.00000000 * z2;
    z2 = z1;
    z1 = x;
  }
  return output;
}
